---
interface Props {
  title: string;
  description?: string;
  locale?: string;
}

const { title, description = 'The Smol Training Playbook - LLM Training Guide', locale = 'en' } = Astro.props;
const currentLocale = Astro.currentLocale || 'en';
---

<!doctype html>
<html lang={currentLocale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- KaTeX CSS for Math Rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <title>{title}</title>

    <!-- Theme initialization (must be in head to prevent flash) -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <style is:global>
      :root {
        --color-bg: #ffffff;
        --color-text: #1a1a2e;
        --color-primary: #6366f1;
        --color-secondary: #8b5cf6;
        --color-accent: #ec4899;
        --color-success: #10b981;
        --color-warning: #f59e0b;
        --color-error: #ef4444;
        --color-border: #e5e7eb;
        --color-surface: #f9fafb;
        --color-primary-light: #eef2ff;
        --text-secondary: #6b7280;
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', monospace;
        --max-width: 1200px;
        --spacing-unit: 1rem;
        --radius-sm: 0.375rem;
        --radius-md: 0.5rem;
        --radius-lg: 0.75rem;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      }

      [data-theme="dark"] {
        --color-bg: #0f0f1a;
        --color-text: #e4e4e7;
        --color-surface: #1a1a2e;
        --color-border: #27272a;
        --color-primary-light: #1e1b4b;
        --text-secondary: #9ca3af;
      }

      html {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      * {
        box-sizing: border-box;
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      a:hover {
        text-decoration: underline;
        color: var(--color-secondary);
      }

      code {
        font-family: var(--font-mono);
        background: var(--color-surface);
        padding: 0.125em 0.375em;
        border-radius: var(--radius-sm);
        font-size: 0.9em;
        border: 1px solid var(--color-border);
      }

      [data-theme="dark"] code {
        background: var(--color-surface);
        border-color: var(--color-border);
      }

      pre {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: var(--radius-md);
        overflow-x: auto;
        box-shadow: var(--shadow-md);
      }

      [data-theme="dark"] pre {
        background: #1e1e2e;
      }

      pre code {
        background: none;
        padding: 0;
        border: none;
        font-size: 0.875rem;
        line-height: 1.7;
      }

      h1, h2, h3, h4, h5, h6 {
        margin: 1.5em 0 0.75em;
        line-height: 1.2;
        font-weight: 600;
        color: var(--color-text);
      }

      h1 {
        font-size: 2.5rem;
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      h2 {
        font-size: 2rem;
        border-bottom: 2px solid var(--color-primary);
        padding-bottom: 0.5rem;
      }

      h3 { font-size: 1.5rem; }
      h4 { font-size: 1.25rem; }

      /* Responsive typography */
      @media (max-width: 768px) {
        h1 { font-size: 2rem; }
        h2 { font-size: 1.5rem; }
        h3 { font-size: 1.25rem; }
      }

      /* Selection styling */
      ::selection {
        background: var(--color-primary);
        color: white;
      }

      /* Scrollbar styling */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }

      ::-webkit-scrollbar-track {
        background: var(--color-surface);
      }

      ::-webkit-scrollbar-thumb {
        background: var(--color-border);
        border-radius: 4px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--color-primary);
      }

      /* Focus styling */
      :focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      /* KaTeX math styling */
      .katex {
        font-size: 1.1em;
      }

      .math-block {
        display: block;
        text-align: center;
        padding: 1rem;
        margin: 1.5rem 0;
        background: var(--color-surface);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        overflow-x: auto;
      }
    </style>
  </head>
  <body>
    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <p>Based on <a href="https://huggingface.co/spaces/HuggingFaceTB/smol-training-playbook" target="_blank" rel="noopener">The Smol Training Playbook</a> by Hugging Face</p>
        <p class="copyright">MIT License | {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .main-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .site-footer {
    margin-top: 4rem;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .footer-content p {
    margin: 0.25rem 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .copyright {
    margin-top: 0.5rem !important;
  }

  @media (max-width: 768px) {
    h1 { font-size: 2rem; }
    h2 { font-size: 1.5rem; }
  }
</style>
