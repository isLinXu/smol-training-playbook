---
interface Props {
  currentLocale?: string;
}
const { currentLocale = 'en' } = Astro.props;
const locale = currentLocale === 'zh' ? '中文' : 'EN';
const targetLocale = currentLocale === 'zh' ? 'en' : 'zh';
const targetLabel = currentLocale === 'zh' ? 'EN' : '中文';
const currentPath = Astro.url.pathname;
---

<div class="language-toggle">
  <button
    id="lang-toggle-btn"
    aria-label={`Switch to ${targetLabel}`}
    title={`Switch to ${targetLabel}`}
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-label">{locale}</span>
  </button>
</div>

<script define:vars={{ targetLocale, currentPath }}>
  const btn = document.getElementById('lang-toggle-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      // 获取当前路径并替换语言前缀
      let newPath;
      if (currentPath.startsWith('/zh')) {
        newPath = currentPath.replace('/zh', '/en');
      } else if (currentPath.startsWith('/en')) {
        newPath = currentPath.replace('/en', '/zh');
      } else if (currentPath === '/') {
        // 首页根据目标语言跳转
        newPath = targetLocale === 'zh' ? '/zh' : '/en';
      } else {
        // 默认行为：在路径前添加语言前缀
        newPath = '/' + targetLocale + currentPath;
      }
      window.location.href = newPath;
    });
  }
</script>

<style>
  .language-toggle {
    display: inline-flex;
    align-items: center;
  }

  #lang-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--color-border, #e5e7eb);
    background: transparent;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    color: var(--text-color, #374151);
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  #lang-toggle-btn:hover {
    background: var(--color-surface, #f3f4f6);
    border-color: var(--color-primary, #6366f1);
    color: var(--color-primary, #6366f1);
  }

  [data-theme="dark"] #lang-toggle-btn {
    border-color: var(--color-border, #4b5563);
    color: var(--text-color, #e5e7eb);
  }

  [data-theme="dark"] #lang-toggle-btn:hover {
    background: var(--color-surface, #374151);
    border-color: var(--color-primary, #818cf8);
    color: var(--color-primary, #818cf8);
  }

  .lang-label {
    font-family: 'SF Mono', 'Menlo', monospace;
    letter-spacing: 0.05em;
  }

  #lang-toggle-btn svg {
    flex-shrink: 0;
  }
</style>
