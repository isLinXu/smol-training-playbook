---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { slug: '01-jianjie' }, props: { locale: 'zh', title: '简介' } },
    { params: { slug: '02-xunlian' }, props: { locale: 'zh', title: '训练罗盘' } },
    { params: { slug: '03-xiaoxiao' }, props: { locale: 'zh', title: '小型消融实验' } },
    { params: { slug: '04-jiagou' }, props: { locale: 'zh', title: '模型架构设计' } },
    { params: { slug: '05-shuju' }, props: { locale: 'zh', title: '数据策划艺术' } },
    { params: { slug: '06-xunlian' }, props: { locale: 'zh', title: '训练马拉松' } },
    { params: { slug: '07-houcheng' }, props: { locale: 'zh', title: '后训练' } },
    { params: { slug: '08-jichu' }, props: { locale: 'zh', title: '基础设施' } },
    { params: { slug: '09-jielun' }, props: { locale: 'zh', title: '结论' } },
    { params: { slug: '10-cankao' }, props: { locale: 'zh', title: '参考文献' } },
  ];
}

const { title } = Astro.props;
const t = useTranslations('zh');
---

<BaseLayout title={`${title} - 训练手册`} locale="zh">
  <article class="chapter-content">
    <header class="chapter-header">
      <a href="/zh" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        {t.common.back}
      </a>
      <h1>{title}</h1>
    </header>

    <div class="content-placeholder">
      <div class="placeholder-icon">📖</div>
      <p>内容正在翻译中...</p>
      <p class="placeholder-note">此章节的中文翻译即将完成，敬请期待。</p>
    </div>
  </article>
</BaseLayout>

<style>
  .chapter-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .chapter-header {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #6b7280;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .chapter-header h1 {
    font-size: 2.5rem;
    margin: 0;
  }

  .content-placeholder {
    text-align: center;
    padding: 4rem 2rem;
    background: #f9fafb;
    border-radius: 0.75rem;
    border: 2px dashed #e5e7eb;
  }

  html.dark .content-placeholder {
    background: #18181b;
    border-color: #27272a;
  }

  .placeholder-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .content-placeholder p {
    margin: 0.5rem 0;
    color: #6b7280;
  }

  .placeholder-note {
    font-size: 0.875rem;
  }
</style>
