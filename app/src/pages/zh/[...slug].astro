---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const zhChapters = await getCollection('zh');

  return zhChapters.map((entry) => {
    // entry.id like "01-jianjie/jianjie.md" -> slug "01-jianjie"
    const parts = entry.id.split('/');
    const chapterDir = parts[0]; // e.g., "01-jianjie"

    return {
      params: { slug: chapterDir },
      props: {
        entry,
        locale: 'zh',
        title: entry.data.title || '简介'
      },
    };
  });
}

const { entry, title } = Astro.props;
const { Content } = await entry.render();
const t = {
  common: { back: '返回' }
};
---

<BaseLayout title={`${title} - 小语言模型训练手册`} locale="zh">
  <div class="top-bar">
    <LanguageToggle currentLocale="zh" />
    <ThemeToggle />
  </div>
  <article class="chapter-content">
    <header class="chapter-header">
      <a href="/zh" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        {t.common.back}
      </a>
      <h1>{title}</h1>
    </header>

    <div class="chapter-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .top-bar {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .chapter-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .chapter-header {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #6b7280;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .chapter-header h1 {
    font-size: 2.5rem;
    margin: 0;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .chapter-body {
    line-height: 1.8;
  }

  .chapter-body :global(h2) {
    font-size: 1.75rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 0.5rem;
  }

  .chapter-body :global(h3) {
    font-size: 1.35rem;
    margin-top: 1.5rem;
  }

  .chapter-body :global(p) {
    margin: 1rem 0;
  }

  .chapter-body :global(ul),
  .chapter-body :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .chapter-body :global(li) {
    margin: 0.5rem 0;
  }

  .chapter-body :global(code) {
    background: var(--color-surface);
    padding: 0.125em 0.375em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  .chapter-body :global(pre) {
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .chapter-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .chapter-body :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    margin: 1rem 0;
    color: #6b7280;
    font-style: italic;
  }

  .chapter-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  .chapter-body :global(th),
  .chapter-body :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.75rem;
    text-align: left;
  }

  .chapter-body :global(th) {
    background: var(--color-surface);
    font-weight: 600;
  }
</style>
