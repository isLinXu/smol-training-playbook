---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return [
    { params: { slug: '01-intro' }, props: { locale: 'en', title: 'Introduction' } },
    { params: { slug: '02-compass' }, props: { locale: 'en', title: 'Training Compass' } },
    { params: { slug: '03-ablations' }, props: { locale: 'en', title: 'Small Ablations' } },
    { params: { slug: '04-architecture' }, props: { locale: 'en', title: 'Model Architecture' } },
    { params: { slug: '05-data' }, props: { locale: 'en', title: 'Data Curation' } },
    { params: { slug: '06-training' }, props: { locale: 'en', title: 'Training Marathon' } },
    { params: { slug: '07-posttraining' }, props: { locale: 'en', title: 'Post-training' } },
    { params: { slug: '08-infrastructure' }, props: { locale: 'en', title: 'Infrastructure' } },
    { params: { slug: '09-conclusion' }, props: { locale: 'en', title: 'Conclusion' } },
    { params: { slug: '10-references' }, props: { locale: 'en', title: 'References' } },
  ];
}

const { title } = Astro.props;
const t = useTranslations('en');
---

<BaseLayout title={`${title} - Smol Training Playbook`} locale="en">
  <article class="chapter-content">
    <header class="chapter-header">
      <a href="/en" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        {t.common.back}
      </a>
      <h1>{title}</h1>
    </header>

    <div class="content-placeholder">
      <div class="placeholder-icon">📖</div>
      <p>Content coming soon...</p>
      <p class="placeholder-note">This chapter is being prepared. Stay tuned!</p>
    </div>
  </article>
</BaseLayout>

<style>
  .chapter-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .chapter-header {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #6b7280;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .chapter-header h1 {
    font-size: 2.5rem;
    margin: 0;
  }

  .content-placeholder {
    text-align: center;
    padding: 4rem 2rem;
    background: #f9fafb;
    border-radius: 0.75rem;
    border: 2px dashed #e5e7eb;
  }

  html.dark .content-placeholder {
    background: #18181b;
    border-color: #27272a;
  }

  .placeholder-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .content-placeholder p {
    margin: 0.5rem 0;
    color: #6b7280;
  }

  .placeholder-note {
    font-size: 0.875rem;
  }
</style>
