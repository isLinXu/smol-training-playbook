---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalePaths } from '../i18n';

export function getStaticPaths() {
  return getLocalePaths();
}

const locale = Astro.currentLocale || 'en';

const content = {
  en: {
    title: 'The Smol Training Playbook',
    subtitle: 'Secrets to Building World-Class Compact Language Models',
    description: 'A comprehensive guide to training small language models, based on the real-world experience of training SmolLM3.',
    chapters: [
      { num: 1, title: 'Introduction', href: '/en/01-intro', desc: 'Start your LLM training journey' },
      { num: 2, title: 'Training Compass', href: '/en/02-compass', desc: 'Methodology: Why → What → How' },
      { num: 3, title: 'Small Ablations', href: '/en/03-ablations', desc: 'Fast iteration with small experiments' },
      { num: 4, title: 'Model Architecture', href: '/en/04-architecture', desc: 'Transformer design decisions' },
      { num: 5, title: 'Data Curation', href: '/en/05-data', desc: 'FineWeb dataset construction' },
      { num: 6, title: 'Training Marathon', href: '/en/06-training', desc: 'Distributed training execution' },
      { num: 7, title: 'Post-training', href: '/en/07-posttraining', desc: 'SFT, DPO, and alignment' },
      { num: 8, title: 'Infrastructure', href: '/en/08-infrastructure', desc: 'GPU optimization and monitoring' },
      { num: 9, title: 'Conclusion', href: '/en/09-conclusion', desc: 'Lessons learned and future directions' },
      { num: 10, title: 'References', href: '/en/10-references', desc: 'Complete reference list' }
    ],
    cta: 'Start Reading',
    viewOnGithub: 'View on GitHub',
    basedOn: 'Based on Hugging Face\'s SmolLM3 training experience'
  },
  zh: {
    title: '小语言模型训练手册',
    subtitle: '构建世界级紧凑型语言模型的秘密',
    description: '基于训练 SmolLM3 的真实经验，全面指南。',
    chapters: [
      { num: 1, title: '简介', href: '/zh/01-jianjie', desc: '开启 LLM 训练之旅' },
      { num: 2, title: '训练罗盘', href: '/zh/02-xunlian', desc: '方法论：为什么 → 是什么 → 怎么做' },
      { num: 3, title: '小型消融实验', href: '/zh/03-xiaoxiao', desc: '小步快跑，快速迭代验证' },
      { num: 4, title: '模型架构设计', href: '/zh/04-jiagou', desc: 'Transformer 架构决策' },
      { num: 5, title: '数据策划艺术', href: '/zh/05-shuju', desc: 'FineWeb 数据集构建经验' },
      { num: 6, title: '训练马拉松', href: '/zh/06-xunlian', desc: '分布式训练配置与执行' },
      { num: 7, title: '后训练', href: '/zh/07-houcheng', desc: 'SFT、DPO 对齐技术' },
      { num: 8, title: '基础设施', href: '/zh/08-jichu', desc: 'GPU 优化与监控' },
      { num: 9, title: '结论', href: '/zh/09-jielun', desc: '经验总结与未来方向' },
      { num: 10, title: '参考文献', href: '/zh/10-cankao', desc: '完整引用列表' }
    ],
    cta: '开始阅读',
    viewOnGithub: '在 GitHub 上查看',
    basedOn: '基于 Hugging Face 训练 SmolLM3 的真实经验'
  }
};

const t = content[locale as keyof typeof content] || content.en;
---

<BaseLayout title={t.title} locale={locale}>
  <section class="hero">
    <div class="hero-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
      </svg>
      {locale === 'en' ? 'Hugging Face Open Source' : 'Hugging Face 开源项目'}
    </div>
    <h1 class="hero-title">{t.title}</h1>
    <p class="hero-subtitle">{t.subtitle}</p>
    <p class="hero-desc">{t.description}</p>
    <div class="hero-actions">
      <a href={t.chapters[0].href} class="btn btn-primary">
        {t.cta}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="https://github.com/isLinXu/smol-training-playbook" class="btn btn-secondary" target="_blank" rel="noopener">
        {t.viewOnGithub}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </div>
  </section>

  <section class="chapters">
    <h2 class="section-title">
      {locale === 'en' ? '📚 Chapter Overview' : '📚 章节概览'}
    </h2>
    <div class="chapter-grid">
      {t.chapters.map((chapter) => (
        <a href={chapter.href} class="chapter-card">
          <span class="chapter-num">{String(chapter.num).padStart(2, '0')}</span>
          <div class="chapter-content">
            <h3 class="chapter-title">{chapter.title}</h3>
            <p class="chapter-desc">{chapter.desc}</p>
          </div>
          <svg class="chapter-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
    </div>
  </section>

  <section class="features">
    <h2 class="section-title">
      {locale === 'en' ? '✨ What You\'ll Learn' : '✨ 你将学到什么'}
    </h2>
    <div class="feature-grid">
      <div class="feature-card">
        <div class="feature-icon">🔬</div>
        <h3>{locale === 'en' ? 'Scientific Approach' : '科学方法'}</h3>
        <p>{locale === 'en' ? 'Systematic ablation studies and data-driven decisions' : '系统化消融研究和数据驱动决策'}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>{locale === 'en' ? 'Practical Optimization' : '实践优化'}</h3>
        <p>{locale === 'en' ? 'GPU optimization, distributed training, and monitoring' : 'GPU 优化、分布式训练与监控'}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h3>{locale === 'en' ? 'Real Data' : '真实数据'}</h3>
        <p>{locale === 'en' ? 'FineWeb dataset curation and quality filtering' : 'FineWeb 数据集策划与质量过滤'}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🎯</div>
        <h3>{locale === 'en' ? 'Alignment Tech' : '对齐技术'}</h3>
        <p>{locale === 'en' ? 'SFT, DPO, and human feedback alignment' : 'SFT、DPO 与人类反馈对齐'}</p>
      </div>
    </div>
  </section>

  <section class="about-note">
    <p>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 16v-4M12 8h.01"/>
      </svg>
      {t.basedOn}
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 3rem;
  }

  html.dark .hero {
    border-color: #27272a;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    color: white;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, #1a1a2e 0%, #6366f1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
    line-height: 1.1;
  }

  html.dark .hero-title {
    background: linear-gradient(135deg, #e4e4e7 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    color: #6b7280;
    margin: 1rem 0;
  }

  .hero-desc {
    font-size: 1.125rem;
    color: #6b7280;
    max-width: 640px;
    margin: 0 auto 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background: #4f46e5;
    transform: translateY(-1px);
    text-decoration: none;
  }

  .btn-secondary {
    background: #f3f4f6;
    color: var(--color-text);
  }

  html.dark .btn-secondary {
    background: #27272a;
  }

  .btn-secondary:hover {
    background: #e5e7eb;
    text-decoration: none;
  }

  html.dark .btn-secondary:hover {
    background: #3f3f46;
  }

  .section-title {
    font-size: 1.75rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .chapter-grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .chapter-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    transition: all 0.2s;
    text-decoration: none;
    color: inherit;
  }

  html.dark .chapter-card {
    background: #18181b;
    border-color: #27272a;
  }

  .chapter-card:hover {
    border-color: var(--color-primary);
    transform: translateX(4px);
    text-decoration: none;
  }

  .chapter-num {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    opacity: 0.5;
    min-width: 2.5rem;
  }

  .chapter-content {
    flex: 1;
  }

  .chapter-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .chapter-desc {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0.25rem 0 0;
  }

  .chapter-arrow {
    color: #9ca3af;
    transition: transform 0.2s;
  }

  .chapter-card:hover .chapter-arrow {
    transform: translateX(4px);
    color: var(--color-primary);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .feature-card {
    padding: 1.5rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    text-align: center;
  }

  html.dark .feature-card {
    background: #18181b;
    border-color: #27272a;
  }

  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }

  .feature-card p {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
  }

  .about-note {
    text-align: center;
    padding: 1.5rem;
    background: #f3f4f6;
    border-radius: 0.75rem;
  }

  html.dark .about-note {
    background: #27272a;
  }

  .about-note p {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    color: #6b7280;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }

    .chapter-card {
      flex-wrap: wrap;
    }

    .chapter-arrow {
      display: none;
    }
  }
</style>
